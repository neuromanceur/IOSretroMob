        dependencies={n:bool(shutil.which(n))for n in('cmake','ctest','clang')};free=shutil.disk_usage(ROOT).free
        result={'project':'IOSretroMob','host':platform.system()+' '+platform.machine(),'python':platform.python_version(),'dependencies':dependencies,'free_bytes':free,'reserve_5_gib_met':free>=5*1024**3,'public_tests_require_apple_firmware':False,'guest_execution':'requires your own authorized firmware; separate from public lab','optional_diagnostic_llvm_env':'IOSRETROMOB_LLVM_BIN'}
        print(json.dumps(result,indent=2));return int(not all(dependencies.values())or free<5*1024**3)
