# Normalize all text to LF in the repo so the Linux/macOS CI runners never see
# CRLF (which would break the bash steps in the workflow YAML).
* text=auto eol=lf

# Binaries
*.png  binary
*.jpg  binary
*.ipa  binary
*.img3 binary
*.dmg  binary

# Preserve byte identities of measured logs and native capture manifests.
reports/relic-maze/GUEST_EXECUTION.log -text
reports/relic-maze/full-playthrough/GUEST_EXECUTION.log -text
reports/relic-maze/full-playthrough/CLCD_REGISTERS.log -text whitespace=-blank-at-eof
reports/relic-maze/clcd-multilayer/initial/CAPTURE.json -text
reports/relic-maze/clcd-multilayer/victory/CAPTURE.json -text
